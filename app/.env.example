# Copy to app/.env and fill in real values. app/.env is git-ignored - never commit it.

# MariaDB of the ERPNext site (via SSH tunnel: ssh -L 13306:127.0.0.1:3306 user@server -N)
DB_HOST=127.0.0.1
DB_PORT=13306
DB_USER=
DB_PASSWORD=
DB_NAME=

# JWT issued by this API (use a long random string in production)
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# SMTP for login / delivery OTP emails
SMTP_SERVER=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
FROM_EMAIL=

# ERPNext REST API (User > API Access > Generate Keys) - needed for photo uploads
FRAPPE_URL=http://204.12.251.252
FRAPPE_API_KEY=
FRAPPE_API_SECRET=
